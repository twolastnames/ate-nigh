{
  "name": "ate-nigh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "test": "jest",
    "lint": "eslint",
    "db": "sudo docker compose up",
    "dbschema": "node --experimental-specifier-resolution=node --loader ts-node/esm  ./bin/generate.ts && npm run format",
    "file": "node --experimental-specifier-resolution=node --loader ts-node/esm  ./bin/file.ts",
    "format": "eslint && prettier --write .",
    "e2e": "start-server-and-test dev http://localhost:3000 \"cypress run --e2e\"",
    "importFoods": "node --experimental-specifier-resolution=node --loader ts-node/esm ./bin/loadFoods.ts --project tsconfig.json"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.4",
    "@mui/material": "^7.3.4",
    "@types/mongodb": "^4.0.6",
    "@types/mongoose": "^5.11.96",
    "mongodb": "^6.19.0",
    "mongoose": "^8.18.1",
    "next": "^15.5.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/eslintrc": "^3",
    "@testing-library/react": "^16.3.0",
    "@types/ejs": "^3.1.5",
    "@types/jsonschema": "^0.0.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cypress": "^15.5.0",
    "ejs": "^3.1.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.2",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "prettier": "^3.6.2",
    "react-test-renderer": "^19.2.0",
    "start-server-and-test": "^2.1.2",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "yaml": "^2.8.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv.bad": [
      "@testing-library/jest-dom/extend-expect"
    ],
    "transform": {
      "^.+\\.[t|j]sx?$": [
        "babel-jest",
        {
          "configFile": "./babelConfig.json"
        }
      ]
    }
  }
}
