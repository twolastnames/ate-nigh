import { useBaseGet, useBasePost } from "./helpers"
import { GetResponse, PostResponse, GetOptions } from "./helpersTypes"

/* eslint-disable @typescript-eslint/no-unused-vars */
import {
<% for(const type of types) { %><%= type %>Type,<% } %>
} from "../types/db"

import {
<% for(const model of Object.keys(schemas.collections)) { %><%= model %>,<% } %>
} from "../util/db"
/* eslint-enable @typescript-eslint/no-unused-vars */

<%   for(const aggregation of schemas.aggregations) { %>
export type <%= aggregation.name %>ResponseType = <%- dumpTypescriptSchema(aggregation.response)%>
export function use<%= 
    aggregation.name
  %>Get(parameters: {
        <%- dumpParametersTypescript(aggregation.pipeline) %>
    }, options?: GetOptions) : GetResponse< <%= aggregation.name %>ResponseType%> > {
  return useBaseGet('/api/<%= aggregation.name.uncapitalize() %>', parameters, options)
}
<% } %>

<%   for(const collection of Object.keys(schemas.collections)) { %>
export function use<%=
  collection
%>Post() : PostResponse< <%= collection %>ResponseType%> > {
  return useBasePost('/api/<%= collection.uncapitalize() %>')
}
<% } %>
